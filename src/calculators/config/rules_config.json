{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "version": "1.0.0",
  "description": "Regras de negócio para cálculo de valores e scores - Zellu IA",
  "last_updated": "2025-10-27",

  "estimator_settings": {
    "description": "Configurações para cálculo de valor estimado",
    "min_value": 500,
    "max_value": 50000,
    "bonus_multipliers": {
      "has_documents": 1.2,
      "multiple_violations": 1.3
    },
    "multiple_violations_threshold": 3
  },

  "cdc_value_rules": {
    "description": "Valores base por artigo do Código de Defesa do Consumidor",
    "42": {
      "description": "Devolução em dobro + dano moral",
      "multiplier": 2.0,
      "moral_damage_base": 2000.0,
      "legal_reference": "Art. 42 - Cobrança indevida"
    },
    "6": {
      "description": "Dano moral por violação de direitos",
      "multiplier": 1.0,
      "moral_damage_base": 3000.0,
      "legal_reference": "Art. 6 - Direitos básicos do consumidor"
    },
    "14": {
      "description": "Reparação por defeito",
      "multiplier": 1.5,
      "moral_damage_base": 1500.0,
      "legal_reference": "Art. 14 - Defeito no serviço"
    },
    "18": {
      "description": "Produto impróprio",
      "multiplier": 1.0,
      "moral_damage_base": 1000.0,
      "legal_reference": "Art. 18 - Produto inadequado"
    },
    "20": {
      "description": "Vício de qualidade",
      "multiplier": 1.0,
      "moral_damage_base": 1000.0,
      "legal_reference": "Art. 20 - Vício do serviço"
    },
    "35": {
      "description": "Descumprimento de oferta",
      "multiplier": 1.0,
      "moral_damage_base": 1500.0,
      "legal_reference": "Art. 35 - Descumprimento de oferta"
    },
    "39": {
      "description": "Práticas abusivas",
      "multiplier": 1.0,
      "moral_damage_base": 2500.0,
      "legal_reference": "Art. 39 - Práticas abusivas"
    },
    "49": {
      "description": "Direito de arrependimento",
      "multiplier": 1.0,
      "moral_damage_base": 500.0,
      "legal_reference": "Art. 49 - Direito de arrependimento"
    },
    "51": {
      "description": "Cláusula abusiva",
      "multiplier": 1.0,
      "moral_damage_base": 2000.0,
      "legal_reference": "Art. 51 - Cláusulas nulas"
    },
    "71": {
      "description": "Cobrança abusiva grave",
      "multiplier": 2.0,
      "moral_damage_base": 5000.0,
      "legal_reference": "Art. 71 - Cobrança abusiva (criminal)"
    }
  },

  "recommendation_base_scores": {
    "description": "Scores base para cada tipo de recomendação",
    "amigavel": {
      "base": 7.0,
      "max": 10.0,
      "description": "Resolução rápida e econômica",
      "estimated_time": "7-15 dias"
    },
    "extrajudicial": {
      "base": 6.0,
      "max": 9.0,
      "description": "Notificação formal com peso legal",
      "estimated_time": "20-45 dias"
    },
    "judicial": {
      "base": 5.0,
      "max": 8.5,
      "description": "Ação judicial com maior prazo",
      "estimated_time": "3-12 meses"
    }
  },

  "score_modifiers": {
    "description": "Modificadores que ajustam scores baseados no contexto",
    "has_documents": {
      "description": "Usuário possui documentação do caso",
      "amigavel": 1.0,
      "extrajudicial": 0.5,
      "judicial": 0.3
    },
    "clear_violation": {
      "description": "Violação grave (Art. 42 ou 71)",
      "articles": ["42", "71"],
      "amigavel": 1.5,
      "extrajudicial": 1.0,
      "judicial": 0.5
    },
    "low_value": {
      "description": "Valor envolvido abaixo do threshold",
      "threshold": 1000,
      "amigavel": 1.0,
      "extrajudicial": 0.3,
      "judicial": -0.5
    },
    "high_value": {
      "description": "Valor envolvido acima do threshold",
      "threshold": 10000,
      "amigavel": -0.5,
      "extrajudicial": 0.5,
      "judicial": 1.0
    },
    "previous_attempts": {
      "description": "Usuário já tentou resolver anteriormente",
      "amigavel": -0.5,
      "extrajudicial": 1.0,
      "judicial": 0.5
    },
    "multiple_violations": {
      "description": "Múltiplas violações detectadas",
      "threshold": 3,
      "amigavel": -0.3,
      "extrajudicial": 0.5,
      "judicial": 1.0
    }
  },

  "reason_templates": {
    "description": "Templates para geração de justificativas",
    "amigavel": {
      "factors": {
        "has_documents": "documentação sólida",
        "high_score": "alta probabilidade de acordo rápido",
        "no_previous_attempts": "primeira tentativa de resolução"
      },
      "default": "resolução rápida e econômica"
    },
    "extrajudicial": {
      "factors": {
        "multiple_violations": "múltiplas violações CDC",
        "has_previous_attempts": "tentativas amigáveis já realizadas"
      },
      "default": "Notificação formal com peso legal"
    },
    "judicial": {
      "factors": {
        "high_value": "valor elevado envolvido",
        "complex_case": "caso complexo com múltiplas violações"
      },
      "default": "Processo formal com maior prazo"
    }
  }
}
